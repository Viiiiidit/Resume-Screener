# Application Settings
PROJECT_NAME="B2B Resume Screener API"
ENVIRONMENT="development"
DEBUG=True
API_V1_PREFIX="/api"

# CORS Configuration (comma-separated or JSON list of origins)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# LLM Provider Configuration ("gemini" or "openai")
LLM_PROVIDER="gemini"
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-2.5-flash"

OPENAI_API_KEY="your-openai-api-key-here"
OPENAI_MODEL="gpt-4o-mini"

# Server Settings
HOST="0.0.0.0"
PORT=8000
